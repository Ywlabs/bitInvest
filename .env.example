# 업비트 Open API 키
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

DEFAULT_TICKER=KRW-BTC
DRY_RUN=true
SIGNAL_COOLDOWN_HOURS=8

# ADD_BUY: DCA 외 추가 매수 (종합점수 기반, 매도 없음)
MONTHLY_ADD_BUY_BUDGET_KRW=1000000
ADD_BUY_MIN_SCORE=5
ADD_BUY_MIN_ORDER_KRW=100000
ADD_BUY_MAX_PER_ORDER_KRW=500000
STRATEGY_SELL_ENABLED=false

SCORE_KIMCHI_FAVORABLE_PCT=1.0
SCORE_KIMCHI_BLOCK_PCT=2.5
SCORE_USD_KRW_BLOCK_PCT=0.5
TRIGGER_ONCHAIN_ENABLED=false
