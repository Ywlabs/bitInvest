# 업비트 Open API 키
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

DEFAULT_TICKER=KRW-BTC
DRY_RUN=true
SIGNAL_COOLDOWN_HOURS=8

# ADD_BUY: 종합점수 기반 소액 추가 매수 (업비트 DCA와 별개, 매도 없음)
MONTHLY_ADD_BUY_BUDGET_KRW=500000
ADD_BUY_MIN_SCORE=5
ADD_BUY_MIN_ORDER_KRW=30000
ADD_BUY_MAX_PER_ORDER_KRW=50000
ADD_BUY_REMAINING_PCT=0.15

# ADD_BUY 등급별 배율 (점수 구간, 금액=잔여×REMAINING_PCT×배율)
ADD_BUY_TIER_LOW_MULTIPLIER=0.8
ADD_BUY_TIER_MID_MULTIPLIER=1.0
ADD_BUY_TIER_HIGH_MULTIPLIER=1.2
ADD_BUY_TIER_MID_MIN_SCORE=7
ADD_BUY_TIER_HIGH_MIN_SCORE=9
STRATEGY_SELL_ENABLED=false

SCORE_KIMCHI_FAVORABLE_PCT=1.0
SCORE_KIMCHI_BLOCK_PCT=2.5
SCORE_USD_KRW_BLOCK_PCT=0.5
TRIGGER_ONCHAIN_ENABLED=false

# Phase 2-A: MTF / ATR / Drawdown / Volume
SCORE_WEEKLY_BEAR_BLOCK_ENABLED=true
ATR_HIGH_RATIO=1.5
ATR_EXTREME_RATIO=2.0
ATR_HIGH_MIN_SCORE_ADD=1.0
ATR_EXTREME_MIN_SCORE_ADD=2.0
ATR_HIGH_SIZE_MULTIPLIER=0.5
ATR_EXTREME_SIZE_MULTIPLIER=0.35
SCORE_VOLUME_CONFIRM_RATIO=1.2
